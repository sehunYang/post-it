[debug] [2026-10-19T04:51:01.202Z] >>> [apiv2][body] PUT http://127.0.0.1:9000/.settings/rules.json "{\n  // Post-it 보안 규칙\n  //\n  // 누구나 Google 로그인으로 쓸 수 있습니다. 대신 로그인한 사람은 자기 UID 아래만 읽고 씁니다.\n  // 소유자(아래 UID)는 제한이 없고, 그 외 계정은 글 하나를 5,000자까지만 저장할 수 있게 해서\n  // 실수로 큰 글을 붙여넣어 무료 한도(저장 1GB)를 잡아먹는 일을 막습니다.\n  //\n  // 규칙 언어에는 자식 개수를 세는 기능이 없어서(numChildren 없음) 글 개수 제한은 걸지 않습니다.\n  // 사용자가 늘어 한도가 걱정되면 Blaze 전환이나 DB 분리로 갑니다(.omc/plans/self-hosted-firebase.md).\n  //\n  // 사진·파일은 Storage 에 두고 여기에는 이름·크기·미리보기만 둡니다(storage.rules, docs/FILES.md).\n  //\n  // 규칙을 바꾸면 Firebase 콘솔 → Realtime Database → 규칙 에 붙여넣고 \"게시\" 해야 적용됩니다.\n  \"rules\": {\n    \".read\": false,\n    \".write\": false,\n\n    \"users\": {\n      \"$uid\": {\n        \".read\": \"auth != null && auth.uid === $uid\",\n        \".write\": \"auth != null && auth.uid === $uid\",\n\n        \"pinned\": {\n          \".validate\": \"!newData.exists() || (newData.isString() && newData.val().length <= 64)\"\n        },\n\n        \"notes\": {\n          \"$noteId\": {\n            \".validate\": \"newData.hasChildren(['text', 'createdAt', 'updatedAt'])\",\n            \"text\": {\n              \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= ($uid === 'PKfixfmWHlVOfBMPPvaileeINRC3' ? 20000 : 5000)\"\n            },\n            \"createdAt\": {\n              \".validate\": \"newData.isNumber()\"\n            },\n            \"updatedAt\": {\n              \".validate\": \"newData.isNumber()\"\n            },\n            // 사진·파일 글 (docs/FILES.md). 본체는 Storage 의 users/{uid}/{noteId}/ 아래에 있습니다.\n            \"files\": {\n              \"$i\": {\n                \".validate\": \"newData.hasChildren(['path', 'name', 'type', 'size'])\",\n                \"path\": {\n                  \".validate\": \"newData.isString() && newData.val().beginsWith('users/' + $uid + '/' + $noteId + '/') && newData.val().length <= 600\"\n                },\n                \"name\": {\n                  \".validate\": \"newData.isString() && newData.val().length > 0 && newData.val().length <= 255\"\n                },\n                \"type\": {\n                  \".validate\": \"newData.isString() && newData.val().length <= 255\"\n                },\n                \"size\": {\n                  \".validate\": \"newData.isNumber() && newData.val() >= 0\"\n                },\n                \"$other\": {\n                  \".validate\": false\n                }\n              }\n            },\n            \"thumb\": {\n              \".validate\": \"newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 60000\"\n            },\n            \"$other\": {\n              \".validate\": false\n            }\n          }\n        },\n\n        \"$other\": {\n          \".validate\": false\n        }\n      }\n    }\n  }\n}\n"
