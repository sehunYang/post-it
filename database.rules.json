{
  // Post-it 보안 규칙
  //
  // 누구나 Google 로그인으로 쓸 수 있습니다. 대신 로그인한 사람은 자기 UID 아래만 읽고 씁니다.
  // 소유자(아래 UID)는 제한이 없고, 그 외 계정은 글 하나를 5,000자까지만 저장할 수 있게 해서
  // 실수로 큰 글을 붙여넣어 무료 한도(저장 1GB)를 잡아먹는 일을 막습니다.
  //
  // 규칙 언어에는 자식 개수를 세는 기능이 없어서(numChildren 없음) 글 개수 제한은 걸지 않습니다.
  // 사용자가 늘어 한도가 걱정되면 Blaze 전환이나 DB 분리로 갑니다(.omc/plans/self-hosted-firebase.md).
  //
  // 규칙을 바꾸면 Firebase 콘솔 → Realtime Database → 규칙 에 붙여넣고 "게시" 해야 적용됩니다.
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "pinned": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 64)"
        },

        "notes": {
          "$noteId": {
            ".validate": "newData.hasChildren(['text', 'createdAt', 'updatedAt'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= ($uid === 'PKfixfmWHlVOfBMPPvaileeINRC3' ? 20000 : 5000)"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },

        "$other": {
          ".validate": false
        }
      }
    }
  }
}
